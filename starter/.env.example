# ── LLM Gateway ─────────────────────────────────────────────────
# Choose ONE provider block below and fill in your key.

# Option A — Groq (free tier, fast inference)
# Get your free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Option B — OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Option C — Azure OpenAI / Flue / any other OpenAI-compatible gateway
# LLM_BASE_URL=https://your-endpoint.openai.azure.com/openai/deployments/your-model
# LLM_API_KEY=your-key
# LLM_MODEL=gpt-4o

# ── Simulator connection ─────────────────────────────────────────
SIM_HOST=localhost

# ── Hub server ──────────────────────────────────────────────────
PORT=3000

# ── Cost control (shared per-seat quota) ─────────────────────────
# Flue meters every call automatically. Stay well under this ceiling.
LLM_QUOTA_TOKENS=500000

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
